        { "name": "Get session request by ID", "request": { "method": "GET", "url": "http://localhost:8080/sessionrequests/1" } },
        { "name": "Add session request", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"requesterId\": 2,\n  \"skillOfferId\": 1,\n  \"requestDate\": \"2026-10-01\",\n  \"status\": \"PENDING\",\n  \"sessionDate\": \"2026-10-05\"\n}", "options": { "raw": { "language": "json" } } }, "url": "http://localhost:8080/sessionrequests" } },
        { "name": "Update session request", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"requesterId\": 2,\n  \"skillOfferId\": 1,\n  \"requestDate\": \"2026-10-01\",\n  \"status\": \"ACCEPTED\",\n  \"sessionDate\": \"2026-10-06\"\n}", "options": { "raw": { "language": "json" } } }, "url": "http://localhost:8080/sessionrequests/1" } },
