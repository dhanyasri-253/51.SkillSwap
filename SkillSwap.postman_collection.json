  "item": [
    {
      "name": "Member",
      "item": [
        { "name": "Get all members", "request": { "method": "GET", "url": "http://localhost:8080/members" } },
        { "name": "Get member by ID", "request": { "method": "GET", "url": "http://localhost:8080/members/1" } },
        { "name": "Add member", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Aarav Mehta\",\n  \"email\": \"aarav.mehta@example.com\",\n  \"phone\": \"9876543210\",\n  \"password\": \"demoPassword123\"\n}", "options": { "raw": { "language": "json" } } }, "url": "http://localhost:8080/members" } },
        { "name": "Update member", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Aarav Mehta\",\n  \"email\": \"aarav.updated@example.com\",\n  \"phone\": \"9876543211\",\n  \"password\": \"demoPassword123\"\n}", "options": { "raw": { "language": "json" } } }, "url": "http://localhost:8080/members/1" } },
        { "name": "Delete member", "request": { "method": "DELETE", "url": "http://localhost:8080/members/1" } }
      ]
    },
    {
