        { "name": "Update skill offer", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"memberId\": 1,\n  \"skillName\": \"Guitar Basics\",\n  \"description\": \"Three beginner guitar sessions\",\n  \"level\": \"Beginner\",\n  \"creditsRequired\": 4\n}", "options": { "raw": { "language": "json" } } }, "url": "http://localhost:8080/skilloffers/1" } },
        { "name": "Delete skill offer", "request": { "method": "DELETE", "url": "http://localhost:8080/skilloffers/1" } }
